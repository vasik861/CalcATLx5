<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArkTheLive | Конвертер ресурсов x5</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background: #121212;
            color: #e0e0e0;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background: #1e1e1e;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }
        h1 {
            text-align: center;
            color: #bb86fc;
        }
        h2 {
            color: #7c4dff;
            margin-top: 30px;
            padding-bottom: 10px;
            border-bottom: 2px solid #7c4dff;
        }
        .el__logo{
            text-align: center;
            margin-bottom: 10px;
        }
        .el__logo img{
            width: 300px;
        }
        .tabs {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .tab {
            padding: 10px 20px;
            cursor: pointer;
            background: #2c2c2c;
            border-radius: 4px;
            margin: 5px;
            transition: background 0.3s;
            color: #e0e0e0;
        }
        .tab.active {
            background: #7c4dff;
            color: #121212;
        }
        .tab:hover {
            background: #3a3a3a;
        }
        .content {
            display: none;
        }
        .content.active {
            display: block;
        }
        .searchable {
            position: relative;
        }
        .searchable input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #333;
            border-radius: 4px;
            font-size: 16px;
            background: #2c2c2c;
            color: #e0e0e0;
            box-sizing: border-box;
        }
        .searchable select {
            width: 100%;
            padding: 10px;
            border: 1px solid #333;
            border-radius: 4px;
            font-size: 16px;
            background: #2c2c2c;
            color: #e0e0e0;
        }
        .output {
            padding: 15px;
            border: 1px solid #333;
            border-radius: 4px;
            background: #2c2c2c;
            margin-top: 10px;
        }
        .output-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #444;
        }
        .output-item:last-child {
            border-bottom: none;
        }
        .output-item strong {
            color: #7c4dff;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            color: #e0e0e0;
        }
        table th, table td {
            border: 1px solid #444;
            padding: 8px;
            text-align: left;
        }
        table th {
            background: #7c4dff;
            font-weight: 500;
        }
        .table-wrapper {
            overflow-x: auto;
        }
        
        /* Стили для конвертера ресурсов */
        .converter-container {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 20px;
            margin: 30px 0;
            align-items: start;
        }
        
        .converter-box {
            background: #2c2c2c;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #444;
        }
        
        .converter-title {
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 15px;
            color: #bb86fc;
            text-align: center;
        }
        
        .converter-select, .converter-input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #555;
            border-radius: 4px;
            background: #1e1e1e;
            color: #e0e0e0;
            font-size: 16px;
        }
        
        .converter-result {
            background: #1e1e1e;
            padding: 15px;
            border-radius: 4px;
            margin-top: 10px;
            border: 1px solid #7c4dff;
            text-align: center;
            font-size: 18px;
            color: #7c4dff;
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .swap-button {
            background: #7c4dff;
            color: white;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 40px;
            transition: background 0.3s;
        }
        
        .swap-button:hover {
            background: #6a3ce8;
        }
        
        .converter-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #7c4dff;
            margin-top: 40px;
        }
        
        .quick-converters {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        
        .quick-converter {
            background: #2c2c2c;
            padding: 15px;
            border-radius: 6px;
            border: 1px solid #444;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .quick-converter:hover {
            background: #3a3a3a;
            border-color: #7c4dff;
        }
        
        .quick-converter-title {
            font-weight: 500;
            color: #bb86fc;
            margin-bottom: 10px;
        }
        
        .quick-converter-result {
            font-size: 16px;
            color: #7c4dff;
        }
        
        .resources-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
            margin-top: 20px;
        }
        
        .resource-item {
            background: #2c2c2c;
            padding: 10px 15px;
            border-radius: 4px;
            border: 1px solid #444;
            display: flex;
            justify-content: space-between;
            transition: all 0.2s;
        }
        
        .resource-item:hover {
            border-color: #7c4dff;
            transform: translateY(-2px);
        }
        
        .resource-name {
            color: #e0e0e0;
        }
        
        .resource-value {
            color: #7c4dff;
            font-weight: 500;
        }

        @media (max-width: 900px) {
            .converter-container {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto;
                gap: 10px;
            }
            
            .swap-button {
                margin: 10px auto;
                order: 3;
            }
            
            .converter-arrow {
                display: none;
            }
            
            .quick-converters {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            }
        }

        @media (max-width: 600px) {
            .container {
                margin: 10px;
                padding: 15px;
            }
            .tabs {
                flex-direction: column;
                align-items: stretch;
            }
            .tab {
                text-align: center;
            }
            .output-item {
                flex-direction: column;
                align-items: flex-start;
            }
            .output-item strong {
                margin-bottom: 5px;
            }
            
            .resources-list {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
