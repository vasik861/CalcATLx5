    <script>
        // Данные о множителях ресурсов для сервера x5
        const resourceMultipliers = {
            "element": 1,
            "element_dust": 1000,
            "element_shard": 100,
            "metal_ingot": 40,
            "metal_raw": 80,
            "crystal": 20,
            "obsidian": 30,
            "polymer_craft": 40,
            "polymer_organic": 46,
            "black_pearl": 8,
            "silica_pearl": 80,
            "cementing_paste": 30,
            "chitin": 60,
            "keratin": 60,
            "wood": 120,
            "stone": 120,
            "flint": 240,
            "fiber": 1200,
            "hide": 80,
            "gasoline": 20,
            "oil": 30,
            "raw_meat": 100,
            "cooked_meat": 96
        };
        
        // Отображение имен ресурсов
        const resourceNames = {
            "element": "Элемент",
            "element_dust": "Элемент (пыль)",
            "element_shard": "Элемент (осколки)",
            "metal_ingot": "Металл (слитки)",
            "metal_raw": "Металл (сырой)",
            "crystal": "Кристалл",
            "obsidian": "Обсидиан",
            "polymer_craft": "Полимер (крафт)",
            "polymer_organic": "Полимер (органический)",
            "black_pearl": "Чёрный жемчуг",
            "silica_pearl": "Жемчуг (белый)",
            "cementing_paste": "Цементная паста",
            "chitin": "Хитин",
            "keratin": "Кератин",
            "wood": "Дерево",
            "stone": "Камень",
            "flint": "Кремень",
            "fiber": "Волокно",
            "hide": "Кожа",
            "gasoline": "Бензин",
            "oil": "Нефть",
            "raw_meat": "Мясо (сырое)",
            "cooked_meat": "Мясо (жареное)"
        };
        
        // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            // Инициализация вкладок
            initTabs();
            
            // Инициализация конвертера
            initConverter();
            
            // Заполнение списка всех ресурсов
            fillResourcesList();
            
            // Расчет быстрых конвертаций
            updateQuickConverters();
        });
        
        // Функция инициализации вкладок
        function initTabs() {
            const tabs = document.querySelectorAll('.tab');
            const contents = document.querySelectorAll('.content');
            
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    
                    // Удаляем активный класс у всех вкладок и контента
                    tabs.forEach(t => t.classList.remove('active'));
                    contents.forEach(c => c.classList.remove('active'));
                    
                    // Добавляем активный класс текущей вкладке и соответствующему контенту
                    this.classList.add('active');
                    document.getElementById(targetId).classList.add('active');
                    
                    // Если открыта вкладка конвертера, обновляем быстрые конвертации
                    if (targetId === 'converter-tab') {
                        updateQuickConverters();
                    }
                });
            });
        }
        
        // Функция инициализации конвертера
        function initConverter() {
            const fromResource = document.getElementById('from-resource');
            const toResource = document.getElementById('to-resource');
            const fromAmount = document.getElementById('from-amount');
            const swapButton = document.getElementById('swap-button');
            const conversionResult = document.getElementById('conversion-result');
            
            // Функция расчета конвертации
            function calculateConversion() {
                const from = fromResource.value;
                const to = toResource.value;
                const amount = parseFloat(fromAmount.value) || 0;
                
                if (!from || !to || amount <= 0) {
                    conversionResult.textContent = "0";
                    return;
                }
                
                // Получаем множители для ресурсов
                const fromMultiplier = resourceMultipliers[from];
                const toMultiplier = resourceMultipliers[to];
                
                if (!fromMultiplier || !toMultiplier) {
                    conversionResult.textContent = "Ошибка";
                    return;
                }
                
                // Расчет: (amount / fromMultiplier) * toMultiplier
                const result = (amount / fromMultiplier) * toMultiplier;
                
                // Форматирование результата
                if (result >= 1000) {
                    conversionResult.textContent = result.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
                } else if (result >= 1) {
                    conversionResult.textContent = result.toFixed(2).replace(/\.?0+$/, "");
                } else {
                    conversionResult.textContent = result.toFixed(4).replace(/\.?0+$/, "");
                }
            }
            
            // Обработчики событий для элементов конвертера
            fromResource.addEventListener('change', calculateConversion);
            toResource.addEventListener('change', calculateConversion);
            fromAmount.addEventListener('input', calculateConversion);
            
            // Обработчик для кнопки обмена
            swapButton.addEventListener('click', function() {
                const fromValue = fromResource.value;
                const toValue = toResource.value;
                const fromAmountValue = fromAmount.value;
                
                // Меняем местами ресурсы
                fromResource.value = toValue;
                toResource.value = fromValue;
                
                // Пересчитываем результат
                calculateConversion();
            });
            
            // Инициализация быстрых конвертеров
            document.querySelectorAll('.quick-converter').forEach(converter => {
                converter.addEventListener('click', function() {
                    const from = this.getAttribute('data-from');
                    const to = this.getAttribute('data-to');
                    const amount = this.getAttribute('data-amount');
                    
                    // Устанавливаем значения в основном конвертере
                    fromResource.value = from;
                    toResource.value = to;
                    fromAmount.value = amount;
                    
                    // Пересчитываем результат
                    calculateConversion();
                });
            });
            
            // Инициализация расчета
            calculateConversion();
        }
        
        // Функция заполнения списка всех ресурсов
        function fillResourcesList() {
            const resourcesList = document.getElementById('all-resources-list');
            resourcesList.innerHTML = '';
            
            // Создаем массив из ключей и сортируем по имени ресурса
            const resourceKeys = Object.keys(resourceMultipliers);
            resourceKeys.sort((a, b) => resourceNames[a].localeCompare(resourceNames[b]));
            
            // Добавляем каждый ресурс в список
            resourceKeys.forEach(key => {
                const item = document.createElement('div');
                item.className = 'resource-item';
                item.innerHTML = `
                    <div class="resource-name">${resourceNames[key]}</div>
                    <div class="resource-value">${resourceMultipliers[key]}</div>
                `;
                
                // Добавляем обработчик клика для использования в конвертере
                item.addEventListener('click', function() {
                    document.getElementById('from-resource').value = key;
                    document.getElementById('from-amount').focus();
                    
                    // Переключаемся на вкладку конвертера
                    document.querySelector('.tab[data-target="converter-tab"]').click();
                    
                    // Пересчитываем результат
                    const event = new Event('change');
                    document.getElementById('from-resource').dispatchEvent(event);
                });
                
                resourcesList.appendChild(item);
            });
        }
        
        // Функция обновления быстрых конвертеров
        function updateQuickConverters() {
            document.querySelectorAll('.quick-converter').forEach(converter => {
                const from = converter.getAttribute('data-from');
                const to = converter.getAttribute('data-to');
                const amount = parseFloat(converter.getAttribute('data-amount')) || 0;
                
                if (!from || !to || amount <= 0) return;
                
                const fromMultiplier = resourceMultipliers[from];
                const toMultiplier = resourceMultipliers[to];
                
                if (!fromMultiplier || !toMultiplier) return;
                
                // Расчет: (amount / fromMultiplier) * toMultiplier
                const result = (amount / fromMultiplier) * toMultiplier;
                
                // Форматирование результата
                let formattedResult;
                if (result >= 1000) {
                    formattedResult = result.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
                } else if (result >= 1) {
                    formattedResult = result.toFixed(2).replace(/\.?0+$/, "");
                } else {
                    formattedResult = result.toFixed(4).replace(/\.?0+$/, "");
                }
                
                // Находим элемент результата внутри конвертера
                const resultElement = converter.querySelector('.quick-converter-result');
                if (resultElement) {
                    resultElement.textContent = formattedResult;
                    resultElement.id = ''; // Убираем старый id
                }
            });
        }
        
